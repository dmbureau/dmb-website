{
  "name": "dmb-website",
  "main": "worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dmb-leads",
      "database_id": "e1416ead-2ac5-4ae7-954f-12376fa07852",
      "migrations_dir": "drizzle"
    }
  ],
  "services": [
    {
      "binding": "DMB_PUBLIC_SITE",
      "service": "dmb-website"
    }
  ],
  "routes": [
    {
      "pattern": "dmbureau.cloud/*",
      "zone_name": "dmbureau.cloud"
    },
    {
      "pattern": "www.dmbureau.cloud/*",
      "zone_name": "dmbureau.cloud"
    }
  ]
}
